{
  "id": "io.github.meowsystem.Eyedropper",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm20"
  ],
  "command": "meowsystem-eyedropper",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--own-name=io.github.meowsystem.Eyedropper",
    "--talk-name=com.system76.CosmicSettingsDaemon.*",
    "--talk-name=com.system76.CosmicSettingsDaemon",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--filesystem=xdg-config/cosmic:rw",
    "--filesystem=xdg-run/pipewire-0"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm20/bin",
    "env": {
      "CARGO_HOME": "/run/build/meowsystem-eyedropper/cargo",
      "LIBCLANG_PATH": "/usr/lib/sdk/llvm20/lib"
    }
  },
  "modules": [
    {
      "name": "meowsystem-eyedropper",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 ./target/release/meowsystem-eyedropper /app/bin/meowsystem-eyedropper",
        "install -Dm0644 ./resources/io.github.meowsystem.Eyedropper.desktop /app/share/applications/io.github.meowsystem.Eyedropper.desktop",
        "install -Dm0644 ./resources/io.github.meowsystem.Eyedropper.metainfo.xml /app/share/metainfo/io.github.meowsystem.Eyedropper.metainfo.xml",
        "install -Dm0644 ./resources/io.github.meowsystem.Eyedropper-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.meowsystem.Eyedropper-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/vitoriamariadb/meowsystem-eyedropper.git",
          "tag": "v0.6.2"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
